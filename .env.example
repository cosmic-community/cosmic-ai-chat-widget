# Cosmic CMS Configuration (automatically provided when deployed)
COSMIC_BUCKET_SLUG=your-bucket-slug
COSMIC_READ_KEY=your-read-key
COSMIC_WRITE_KEY=your-write-key

# Resend Email Service
RESEND_API_KEY=re_your-resend-api-key-here

// .env.example
# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# Note: Demo login credentials are stored in Cosmic (team_members Object Type)
# Email: admin@example.com
# Password: Retrieve from your Cosmic bucket's team_members object

# Widget Security
WIDGET_SECRET=your-widget-secret-key-for-authentication

# Optional: Email for notifications
NOTIFICATION_EMAIL=team@example.com